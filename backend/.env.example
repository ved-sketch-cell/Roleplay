# For a manually run local FastAPI server. Generate a random JWT_SECRET.
DATABASE_URL=postgresql+psycopg://roleplay:YOUR_LOCAL_PASSWORD@localhost:5432/roleplay
JWT_SECRET=
ENVIRONMENT=development
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
OPENAI_API_KEY=
OPENAI_MODEL=
RATE_LIMITS_ENABLED=true

REDIS_URL=redis://localhost:6379/0
OUTBOX_ENCRYPTION_KEY=
PUBLIC_WEB_URL=http://localhost:5173
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_FROM=noreply@example.com
SMTP_USERNAME=
SMTP_PASSWORD=
