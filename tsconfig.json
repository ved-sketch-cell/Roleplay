{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "types": [
      "react",
      "react-dom"
    ],
    "paths": {
      "motion/react": [
        "./src/website/motion-bridge.tsx"
      ]
    }
  },
  "include": [
    "src/main.tsx",
    "src/original.tsx",
    "src/website"
  ]
}
